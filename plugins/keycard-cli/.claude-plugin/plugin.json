{
  "name": "keycard-cli",
  "description": "A plugin to integrate the Keycard CLI with Claude Code.",
  "license": "Apache-2.0",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$KEYCARD_RUN\" ] && printf 'Note: this session was not started via `keycard run`. Keycard credential injection and tool-use auditing are inactive.\\nRelaunch with: keycard run -- claude\\n'; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "keycard agent hook claude",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "keycard agent hook claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "keycard agent hook claude"
          }
        ]
      }
    ]
  },
  "version": "0.0.8"
}
